{
  "name": "Demo Dust Sweeper",
  "version": "1.0.0",
  "chains": ["solana", "base"],
  "triggers": [
    {
      "type": "cron",
      "schedule": "0 0 * * 0"
    }
  ],
  "actions": [
    {
      "type": "claim_dust",
      "chains": ["solana", "base"]
    },
    {
      "type": "alert",
      "message": "Weekly dust cleanup completed",
      "severity": "info"
    }
  ],
  "metadata": {
    "author": "chainforge-demo",
    "description": "A simple strategy that demonstrates ClaimDust integration",
    "tags": ["demo", "dust"]
  }
}